# Port the API and dashboard listen on.
PORT=3000

# SQLite file. Defaults to apps/server/data/flakeradar.db.
# DATABASE_PATH=./data/flakeradar.db

# Public URL of the dashboard, used for links in pull request comments.
PUBLIC_URL=http://localhost:3000

# When set, creating projects, rotating tokens and quarantining tests
# require this token. Leave empty for local development only.
ADMIN_TOKEN=

LOG_LEVEL=info
