{
  "name": "@flakeradar/server",
  "version": "0.1.0",
  "private": true,
  "description": "FlakeRadar API: ingests JUnit reports, stores history in SQLite and serves the dashboard.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "seed": "tsx src/seed.ts",
    "export-demo": "tsx src/export-demo.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/static": "^10.1.6",
    "@flakeradar/core": "0.1.0",
    "better-sqlite3": "^12.11.1",
    "fastify": "^5.6.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "tsx": "^4.20.6"
  }
}
